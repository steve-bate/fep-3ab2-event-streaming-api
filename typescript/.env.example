# Demo configuration for the FEP-3ab2 TypeScript example.
#
# Copy this file to `.env` (gitignored) and edit it. Every setting has a working
# default, so an empty file still runs the demo on http://localhost:5180 with the
# API on http://localhost:5181.

# Absolute origin the API advertises in the session response, e.g.
# https://fep.example.com. Leave it unset to derive the origin from each
# request's Host header (which keeps localhost and 127.0.0.1 both working).
# DEMO_API_ORIGIN=

# Absolute origin the demo page is served from, e.g. https://app.example.net.
# Leave it unset to allow http://localhost:<port> and http://127.0.0.1:<port>.
#
# This is also the CORS allowlist, and it has to be filled in: the demo signs in
# with cookies, which name the Principal but not the client, so the server cannot
# bind a client's registered origin and must be told which pages may call it.
# DEMO_WEB_ORIGIN=

# Comma-separated CORS allowlist; overrides DEMO_WEB_ORIGIN when set.
# DEMO_WEB_ORIGINS=https://app.example.net,https://admin.example.net

DEMO_API_PORT=5181
DEMO_WEB_PORT=5180

# Mount the API on the page's port: one port, no cross-origin requests.
# DEMO_SINGLE_ORIGIN=1

# Ticket lifetime (seconds) and heartbeat interval (milliseconds). The advertised
# heartbeat_interval is this value rounded up to whole seconds.
DEMO_TICKET_TTL_SECONDS=120
DEMO_HEARTBEAT_INTERVAL_MS=10000

# Ticket cookie SameSite policy: Lax (default), Strict, or None.
# Lax works for a same-site pair such as app.example.com → api.example.com.
# Cross-site needs None, which requires an https DEMO_API_ORIGIN.
DEMO_COOKIE_SAMESITE=Lax

# Cross-site example (page and API on different registrable domains):
# DEMO_API_ORIGIN=https://api.example.com
# DEMO_WEB_ORIGIN=https://app.example.net
# DEMO_COOKIE_SAMESITE=None

# Clients that may ask for a bearer token, as id@origin pairs. Each origin is
# trusted without an allowlist entry, the client-bound path in the FEP: the token
# says which client is calling, the registered origin says where it may come from.
# Defaults to one client at DEMO_WEB_ORIGIN, the demo page.
# DEMO_CLIENTS=demo-page@https://app.example.net,other@https://other.example.org

# Drop the allowlist entirely: every origin is trusted only through the client
# behind a bearer token. Needs /demo/token, which registers the calling origin.
# DEMO_CLIENT_ONLY=1

# Demo credentials.
DEMO_USER=alice
DEMO_PASSWORD=demo

# Set to 0 to silence the per-request streaming log.
DEMO_LOG=1

# Use a different env file (also read from the environment).
# DEMO_ENV_FILE=/etc/fep-3ab2/demo.env
